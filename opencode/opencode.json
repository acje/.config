{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "websearch": false,
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 24000
    },
    "buffer": 30000
  },
  "provider": {
    "dramallama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://aiapi.mattilsynet.no/v1"
      },
      "models": {
        "code": {
          "id": "drama/code-thinking",
          "variants": {
            "instruct-general": {
              "temperature": 0.7,
              "top_p": 0.8,
              "top_k": 20,
              "min_p": 0.0,
              "presence_penalty": 1.5,
              "repetition_penalty": 1.0
            },
            "instruct-reasoning": {
              "temperature": 1.0,
              "top_p": 1.0,
              "top_k": 40,
              "min_p": 0.0,
              "presence_penalty": 2.0,
              "repetition_penalty": 1.0
            }
          },
          "tool_call": true,
          "limit": {
            "context": 192000,
            "input": 192000,
            "output": 8000
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "thinking": {
          "id": "drama/code-thinking",
          "variants": {
            "precise-coding": {
              "temperature": 0.6,
              "top_p": 0.95,
              "top_k": 20,
              "min_p": 0.0,
              "presence_penalty": 0.0,
              "repetition_penalty": 1.0
            },
            "general-tasks": {
              "temperature": 1.0,
              "top_p": 0.95,
              "top_k": 20,
              "min_p": 0.0,
              "presence_penalty": 1.5,
              "repetition_penalty": 1.0
            }
          },
          "tool_call": true,
          "limit": {
            "context": 192000,
            "input": 192000,
            "output": 32000
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "deepseek-v4-flash": {
          "limit": {
            "context": 200000,
            "output": 32000
          }
        }
      }
    }
  },
  "permission": {
    "read": {
      "**/.envrc": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.env": "deny",
      "**/.netrc": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.crt": "deny",
      "**/*.cer": "deny",
      "**/.ssh/**": "deny",
      "**/.ssh": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/id_ecdsa": "deny",
      "**/known_hosts": "deny",
      "**/authorized_keys": "deny",
      "**/.docker/config.json": "deny",
      "**/.npmrc": "deny",
      "**/.cargo/credentials": "deny",
      "**/.cargo/credentials.toml": "deny",
      "**/secrets/**": "deny",
      "**/.git-credentials": "deny",
      "**/*credentials*": "deny",
      "**/*Credentials*": "deny",
      "**/*password*": "deny",
      "**/*Password*": "deny",
      "**/*secret*": "deny",
      "**/*Secret*": "deny",
      "**/*.token": "deny"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push --force-with-lease*": "allow",
      "git reset --hard*": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      ":(){ :|:& };:": "deny",
      "curl * | sh": "deny",
      "wget * | sh": "deny",
      "chmod -R 777 *": "deny"
    },
    "edit": "allow",
    "write": "allow",
    "external_directory": {
      "**": "deny",
      "~/tmp/**": "allow",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
      "/var/folders/**": "allow",
      "~/.cargo/registry/**": "allow",
      "~/.config/opencode/skills/**": "allow",
      "~/.agents/skills/**": "allow",
      "~/.claude/skills/**": "allow"
    }
  },
  "model": "dramallama/deepseek-v4-flash#high",
  "experimental": {
    "subagent_depth": 4,
    "background_compaction": true
  },
  "plugins": [
    {
      "package": "@mattilsynet/opencode-dramallama-provider",
      "options": {
        "baseURL": "https://aiapi.mattilsynet.no/v1"
      }
    }
  ],
  "mcp": {
    "servers": {
      "searxng": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "mcp-searxng@2.7.0"
        ],
        "environment": {
          "SEARXNG_URL": "http://127.0.0.1:19217"
        }
      }
    }
  },
  "agent": {
    "build": {
      "prompt": "{file:./prompts/build.md}",
      "model": "dramallama/deepseek-v4-flash#high",
      "reasoningEffort": "high"
    },
    "plan": {
      "prompt": "{file:./prompts/plan.md}",
      "model": "dramallama/deepseek-v4-flash#high",
      "reasoningEffort": "high"
    },
    "moltke": {
      "prompt": "{file:./agents/moltke.md}",
      "mode": "subagent",
      "model": "dramallama/deepseek-v4-flash#high",
      "reasoningEffort": "high"
    },
    "hopper": {
      "prompt": "{file:./agents/hopper.md}",
      "mode": "subagent",
      "model": "dramallama/deepseek-v4-flash#high",
      "reasoningEffort": "high"
    },
    "copernicus": {
      "prompt": "{file:./agents/copernicus.md}",
      "mode": "subagent",
      "model": "dramallama/deepseek-v4-flash#high",
      "reasoningEffort": "high"
    },
    "feynman": {
      "prompt": "{file:./agents/feynman.md}",
      "mode": "subagent",
      "model": "dramallama/deepseek-v4-flash#high",
      "reasoningEffort": "high"
    },
    "oracle": {
      "prompt": "{file:./agents/oracle.md}",
      "mode": "subagent",
      "model": "dramallama/deepseek-v4-flash#high",
      "reasoningEffort": "high"
    },
    "linus": {
      "prompt": "{file:./agents/linus.md}",
      "mode": "subagent",
      "model": "dramallama/deepseek-v4-flash#high",
      "reasoningEffort": "high"
    },
    "hamilton": {
      "prompt": "{file:./agents/hamilton.md}",
      "mode": "subagent",
      "model": "dramallama/deepseek-v4-flash#high",
      "reasoningEffort": "high"
    },
    "gardener": {
      "prompt": "{file:./agents/gardener.md}",
      "mode": "subagent",
      "model": "dramallama/deepseek-v4-flash#high",
      "reasoningEffort": "high"
    }
  }
}
