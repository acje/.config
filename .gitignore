# Default-Deny Allowlist Policy for ~/.config
# ---------------------------------------------------------------------------
# Everything in ~/.config is ignored by default so new tools, state dirs,
# runtime logs, or credentials are never accidentally staged or published.
# Only explicitly allowlisted paths below can be tracked by Git.

# 1. Default deny at root
/*

# 2. Allowlisted root files
!/.gitignore
!/AGENTS.md
!/LICENSE

# 3. Allowlisted ghostty config (explicit file allowlist)
!/ghostty/
/ghostty/*
!/ghostty/config

# 4. Allowlisted opencode config (explicit directory/file allowlist)
!/opencode/
/opencode/*
!/opencode/AGENTS.md
!/opencode/DB-MAINTENANCE.md
!/opencode/README.md
!/opencode/opencode.json
!/opencode/package.json
!/opencode/package-lock.json
!/opencode/search-readiness.mjs
!/opencode/search-readiness.test.mjs
!/opencode/dramallama-guard.test.mjs
!/opencode/plugins-command-preservation.test.mjs
!/opencode/agents/
!/opencode/commands/
!/opencode/plugins/
!/opencode/prompts/
!/opencode/skills/
!/opencode/maintenance/

# Inside opencode/maintenance, allow only code and plist (ignore *.log, backups/)
/opencode/maintenance/*
!/opencode/maintenance/com.opencode.db-maintenance.daily.plist
!/opencode/maintenance/opencode_db_maintenance.py
!/opencode/maintenance/test_maintenance.py

# 5. Global belt-and-braces exclusions (apply at any depth inside allowlisted dirs)
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.bak
*.bak.*
*.log
__pycache__/
*.pyc
node_modules/
target/
.ooda/
.beads/
.beads.gate.lock
auth.json

# Secrets & credentials (mirroring opencode.json permission.read denylist)
.env
.env.*
*.env
.envrc
.netrc
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.token
*credentials*
*Credentials*
*secret*
*Secret*
*password*
*Password*
