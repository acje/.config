# Allowlist / Whitelist Policy for ~/.config dotfiles
# ---------------------------------------------------
# Because this repo's root is ~/.config, any CLI tool or application that drops
# state or credentials into ~/.config must be ignored by default.
# Only explicitly whitelisted dotfiles and directories are tracked.

# 1. Ignore everything at root by default
/*

# 2. Whitelist tracked root files
!/.gitignore
!/AGENTS.md
!/LICENSE

# 3. Whitelist tracked root directories
!/ghostty/
!/opencode/
!/openspec/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Backups
*.bak
*.bak.*

# Top-level local scratch (anchored to repo root; redundant with /* but retained for clarity)
/gh/
/containers/
/searxng/
/gcloud/
/bd/

# Agent / tooling state
opencode/auth.json
opencode/.opencode/
.ooda/
.beads/
.beads.gate.lock
/opencode-usage.csv

# Build / dep artefacts (generic, not path-pinned)
node_modules/
target/

# Secrets belt-and-braces — mirrors highest-risk entries from
# opencode.json permission.read denylist. .gitignore stops commits;
# the denylist stops reads. Defence in depth.
.env
.env.*
*.env
.envrc
.netrc
*.pem
*.key
*.token
